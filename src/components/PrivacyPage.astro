---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const p = t('privacy');
const contactEmail = 'indiandevelopers7@gmail.com';
const unityPolicyUrl = 'https://unity.com/legal/privacy-policy';
const googlePolicyUrl = 'https://policies.google.com/privacy';
---

<BaseLayout locale={locale} route="privacy" title={p.title} description={p.description}>
  <main id="main" class="policy">
    <a class="back-link" href={localizedPath('home', locale)}>{p.back}</a>
    <h1>{p.heading}</h1>
    <p class="meta">{p.effectiveDate}</p>
    <p class="meta">{p.appNameLine}</p>

    <h2>{p.s1.h}</h2>
    <p>{p.s1.p}</p>

    <h2>{p.s2.h}</h2>
    <p><strong>{p.s2.personalLabel}</strong></p>
    <p>{p.s2.personalP}</p>
    <p><strong>{p.s2.progressLabel}</strong></p>
    <p>{p.s2.progressP}</p>
    <p><strong>{p.s2.nonPersonalLabel}</strong></p>
    <p>{p.s2.nonPersonalP}</p>
    <ul>{p.s2.items.map((item) => <li>{item}</li>)}</ul>
    <p>{p.s2.closing}</p>

    <h2>{p.s3.h}</h2>
    <p>{p.s3.p}</p>
    <p><strong>{p.s3.placementLabel}</strong></p>
    <p>{p.s3.placementP}</p>
    <p><strong>{p.s3.formatLabel}</strong></p>
    <p>{p.s3.formatP}</p>
    <p>{p.s3.dataP}</p>
    <ul>{p.s3.items.map((item) => <li>{item}</li>)}</ul>
    <p>{p.s3.optOut}</p>
    <p>{p.s3.premiumNote}</p>
    <p>
      {p.s3.learnMore}{' '}
      <a href={unityPolicyUrl} target="_blank" rel="noopener noreferrer">
        {unityPolicyUrl}
      </a>
    </p>

    <h2>{p.s4.h}</h2>
    <p>{p.s4.p}</p>
    <p>{p.s4.billingP}</p>
    <p>{p.s4.restoreP}</p>
    <p>
      {p.s4.learnMore}{' '}
      <a href={googlePolicyUrl} target="_blank" rel="noopener noreferrer">
        {googlePolicyUrl}
      </a>
    </p>

    <h2>{p.s5.h}</h2>
    <p>{p.s5.p}</p>
    <ul>
      {
        p.s5.items.map((item) => (
          <li>
            <strong>{item.name}</strong> — {item.data}
          </li>
        ))
      }
    </ul>

    <h2>{p.s6.h}</h2>
    <p>{p.s6.p}</p>
    <ul>{p.s6.items.map((item) => <li>{item}</li>)}</ul>
    <p>{p.s6.closing}</p>

    <h2>{p.s7.h}</h2>
    <p>{p.s7.p}</p>

    <h2>{p.s8.h}</h2>
    <p>{p.s8.p}</p>

    <h2>{p.s9.h}</h2>
    <p>{p.s9.p}</p>

    <h2>{p.s10.h}</h2>
    <p>{p.s10.p}</p>
    <p>
      <strong>{p.s10.emailLabel}</strong>{' '}
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
    <p>
      <strong>{p.s10.deletionLabel}</strong>{' '}
      <a href={localizedPath('delete-account', locale)}>{p.s10.deletionLink}</a>
    </p>
  </main>
</BaseLayout>
